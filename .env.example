NODE_ENV=development
LOG_LEVEL=debug

DATABASE_URL=file:./data/delta-qoralis.sqlite

# Discovery is disabled unless this is set exactly to geoapify.
DISCOVERY_PROVIDER=disabled
GEOAPIFY_API_KEY=

# Unused placeholder: Google Places is not an approved discovery provider.
# This value is not parsed and has no runtime effect or fallback behavior.
GOOGLE_PLACES_API_KEY=

AI_PROVIDER=
OPENAI_API_KEY=
GEMINI_API_KEY=

EMAIL_PROVIDER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

GITHUB_TOKEN=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

STRIPE_SECRET_KEY=

DEPLOYMENT_PROVIDER=
DEPLOYMENT_TOKEN=
